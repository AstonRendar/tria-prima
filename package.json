{
  "name": "tria-prima",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~56.0.4",
    "expo-constants": "~56.0.15",
    "expo-linking": "~56.0.11",
    "expo-router": "~56.2.6",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.12",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/domain/**/*.ts",
      "src/application/**/*.ts",
      "!**/__tests__/**"
    ],
    "projects": [
      {
        "displayName": "logic",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "testMatch": [
          "<rootDir>/src/domain/**/__tests__/**/*.test.ts",
          "<rootDir>/src/application/**/__tests__/**/*.test.ts",
          "<rootDir>/src/infrastructure/**/__tests__/**/*.test.ts"
        ]
      },
      {
        "displayName": "ui",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/src/ui/**/__tests__/**/*.test.tsx"
        ]
      }
    ]
  },
  "private": true
}
